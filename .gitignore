__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# Generated at run time, not source
build_stats.json
items.jsonl
results/
acts/
figures/
qa/

# Downloaded Kaggle output folders. Kept locally for auditability, never
# committed: they duplicate the evid6/ source tree, which invites editing the
# wrong copy. `acts/` and `results/` above already exclude the heavy .npy and
# .jsonl payloads; these two lines exclude the folders wholesale.
results-nb3/
vlm nb2 results/
vlm nb5 output/
evid6_nb4_output/
evid6_nb4_output.zip
nb5 v2 result/
nb5 v2 result.zip
nb 9 results/
relabel_share/
relabel_share.zip

# Never commit a relabel key. The 100-item blind self-relabel is only valid if
# the sheet is filled in WITHOUT having seen the answers; a key in the repo is
# one click away and voids the protocol. Note that the downloaded Kaggle
# output zips carry `relabel/relabel_key.json` INSIDE them, so the archives are
# excluded above by name too -- the rules below only catch it once extracted.
relabel/
relabel_key.json
nb7 results/
